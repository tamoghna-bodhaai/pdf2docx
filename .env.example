# --- Mathpix Files API -------------------------------------------------------
# Required. Create credentials at https://console.mathpix.com/.
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
MATHPIX_URL=https://api.mathpix.com

# Default for API clients that omit a per-job format selection. Blank requests
# every supported Mathpix export; the browser sends its exact checkbox selection.
# Available requested formats: docx, md, tex.zip, html, html.zip, md.zip,
# mmd.zip, pdf, latex.pdf, pptx, xlsx. Mathpix also returns mmd, lines.json,
# and lines.mmd.json automatically.
PDF2DOCX_MATHPIX_FORMATS=

# Passed through to Mathpix. The application's per-job conversion_formats value
# wins so these options cannot silently broaden a user's checkbox selection.
PDF2DOCX_MATHPIX_OPTIONS={}

# Privacy defaults: do not retain the PDF for model improvement, and delete the
# remote upload after exports and referenced preview images are stored locally.
PDF2DOCX_MATHPIX_IMPROVE=off
PDF2DOCX_MATHPIX_DELETE=on

# Per-request timeouts plus the deadline for the whole conversion/export wait.
PDF2DOCX_MATHPIX_CONNECT_TIMEOUT=10
PDF2DOCX_MATHPIX_REQUEST_TIMEOUT=120
PDF2DOCX_MATHPIX_POLL_INTERVAL=2
PDF2DOCX_MATHPIX_POLL_TIMEOUT=1800

# Used only for the estimated cost stored on a job; Mathpix does not report the
# billed amount through this workflow.
PDF2DOCX_MATHPIX_PAGE_RATE=0.0015

# --- Accounts ---------------------------------------------------------------
# Comma-separated codes, any one of which creates an account. Give each teammate
# their own so a code can be withdrawn without disturbing anybody else's. Blank
# closes sign-ups rather than opening them, so an unconfigured deployment cannot
# be registered with by a stranger — which matters because Mathpix bills per
# page. Wrong codes are rate limited per caller (10 per hour), which is what
# makes a short numeric code safe to hand out.
PDF2DOCX_INVITE_CODES=

# How long a sign-in lasts.
PDF2DOCX_SESSION_DAYS=30

# Set to `off` only for local development over plain HTTP. Anything reachable
# over TLS — a Railway deployment included — wants this on.
PDF2DOCX_COOKIE_SECURE=on

# Largest PDF that may be uploaded, in megabytes. 0 means no limit.
PDF2DOCX_MAX_UPLOAD_MB=50

# --- Local preview and storage ----------------------------------------------
# Source-page rendering resolution and maximum long edge in pixels.
PDF2DOCX_DPI=180
PDF2DOCX_MAX_EDGE=2000

# Hard page limit. 0 means unlimited.
PDF2DOCX_MAX_PAGES=0

# Job directories and the accounts/history database. Defaults to ~/.pdf2docx
# when blank. On Railway this is the volume mount point — /data.
PDF2DOCX_DATA_DIR=

# Oldest jobs are removed with their files, counted per account. 0 keeps
# everything.
PDF2DOCX_HISTORY_LIMIT=100

# Legacy Vision/Marker/layout settings remain supported by dormant internal
# code for rollback, but the web UI and web-created jobs do not read them.
