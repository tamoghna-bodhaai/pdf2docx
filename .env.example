# --- Mathpix Files API -------------------------------------------------------
# Required. Create credentials at https://console.mathpix.com/.
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
MATHPIX_URL=https://api.mathpix.com

# Default for API clients that omit a per-job format selection. Blank requests
# every supported Mathpix export; the browser sends its exact checkbox selection.
# Available requested formats: docx, md, tex.zip, html, html.zip, md.zip,
# mmd.zip, pdf, latex.pdf, pptx, xlsx. Mathpix also returns mmd, lines.json,
# and lines.mmd.json automatically.
PDF2DOCX_MATHPIX_FORMATS=

# Passed through to Mathpix. The application's per-job conversion_formats value
# wins so these options cannot silently broaden a user's checkbox selection.
PDF2DOCX_MATHPIX_OPTIONS={}

# Privacy defaults: do not retain the PDF for model improvement, and delete the
# remote upload after exports and referenced preview images are stored locally.
PDF2DOCX_MATHPIX_IMPROVE=off
PDF2DOCX_MATHPIX_DELETE=on

# Per-request timeouts plus the deadline for the whole conversion/export wait.
PDF2DOCX_MATHPIX_CONNECT_TIMEOUT=10
PDF2DOCX_MATHPIX_REQUEST_TIMEOUT=120
PDF2DOCX_MATHPIX_POLL_INTERVAL=2
PDF2DOCX_MATHPIX_POLL_TIMEOUT=1800

# Used only for the estimated cost stored on a job; Mathpix does not report the
# billed amount through this workflow.
PDF2DOCX_MATHPIX_PAGE_RATE=0.0015

# --- Fitting the DOCX -------------------------------------------------------
# Mathpix sizes every image at its crop's pixel count over 96 DPI rather than at
# the size the figure occupied on the page, pins each table to an absolute grid
# with no declared widths, and leaves long equations nowhere to wrap. All three
# hold together at the 6in measure Mathpix assumes and come apart at any other,
# which is why a Mathpix DOCX cannot be put into two columns. Fitting restates
# that geometry relatively; it changes no text, maths or image crop.
# `mathpix/document.docx` stays byte-for-byte whatever this is set to.
PDF2DOCX_FIT_DOCX=on

# The most of the measure one image may occupy. 1.0 lets a genuinely full-width
# figure stay full width; lower it to keep text around every figure.
PDF2DOCX_FIT_MAX_IMAGE_WIDTH=1.0

# Indent of a wrapped line of a broken equation, in twips. Mathpix writes 1440 —
# a full inch — which is affordable across six inches and not across a column.
PDF2DOCX_FIT_WRAP_INDENT=360

# The one type size the fitted document states, headings included. Word honours
# it everywhere; LibreOffice draws every equation at its own fixed 12pt whatever
# the file says, so 12 is what makes text and maths agree there. 0 keeps
# whatever sizes Mathpix wrote.
PDF2DOCX_FIT_FONT_POINTS=10

# Left and right margin of every section of the exported document, in inches.
# A scanned book's own margins are a binding allowance rather than a reading
# one, and half an inch gives the measure back to the figures and equations that
# were overflowing. 0 keeps whatever margins the document already states.
PDF2DOCX_FIT_SIDE_MARGIN=0.5

# --- Accounts ---------------------------------------------------------------
# Comma-separated codes, any one of which creates an account. Give each teammate
# their own so a code can be withdrawn without disturbing anybody else's. Blank
# closes sign-ups rather than opening them, so an unconfigured deployment cannot
# be registered with by a stranger — which matters because Mathpix bills per
# page. Wrong codes are rate limited per caller (10 per hour), which is what
# makes a short numeric code safe to hand out.
PDF2DOCX_INVITE_CODES=

# How long a sign-in lasts.
PDF2DOCX_SESSION_DAYS=30

# Whether the session cookie is marked `Secure`. `auto` reads the scheme off the
# request, which is right in both places this runs, and is what you want unless
# something unusual sits in front of the app. Marking a cookie `Secure` over
# plain HTTP does not weaken it — the browser throws it away, and silently, so
# the sign-in appears to succeed and then bounces straight back to the form.
# `on` and `off` force it either way.
PDF2DOCX_COOKIE_SECURE=auto

# Largest PDF that may be uploaded, in megabytes. 0 means no limit.
PDF2DOCX_MAX_UPLOAD_MB=50

# --- Local preview and storage ----------------------------------------------
# Source-page rendering resolution and maximum long edge in pixels.
PDF2DOCX_DPI=180
PDF2DOCX_MAX_EDGE=2000

# Hard page limit. 0 means unlimited.
PDF2DOCX_MAX_PAGES=0

# Job directories and the accounts/history database.
#
# Leave this blank. On Railway the path is read from RAILWAY_VOLUME_MOUNT_PATH,
# which is set only when a volume is genuinely attached — so the location and
# the proof that it is durable are the same fact and cannot disagree. Setting it
# by hand overrides that, and a value pointing off the volume is how everything
# written gets destroyed by the next deploy; the app refuses to start rather
# than let that happen. Blank falls back to ~/.pdf2docx off Railway.
#
# Attach the volume with:  railway volume add -m /data
PDF2DOCX_DATA_DIR=

# Oldest jobs are removed with their files, counted per account. 0 keeps
# everything.
PDF2DOCX_HISTORY_LIMIT=100

