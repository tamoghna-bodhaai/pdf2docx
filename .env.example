# OmiCheckr — Copy to .env and fill OPENROUTER_API_KEY
# Get key at https://openrouter.ai/keys (create account → Keys → Create)

# --- Vision LLM via OpenRouter (verified models on OpenRouter) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001

# OpenRouter attribution (recommended, helps ranking; optional)
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=OmiCheckr

# Enable real Vision LLM (false = use key above, true = use deterministic mock)
MOCK_VISION=false

# Confidence threshold for OMR (0-1): below this VLLM answers become UNCERTAIN. Default 0.75. Single retry on invalid.
CONFIDENCE_THRESHOLD=0.75

# Railway: set RAILWAY_VOLUME_MOUNT_PATH=/data if you mount a volume (uploads + data persist there)
# RAILWAY_VOLUME_MOUNT_PATH=/data

# --- Alternatives (leave empty if using OpenRouter) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=google/gemini-2.0-flash-001
# LLM_VISION_MODEL=google/gemini-2.0-flash-001
