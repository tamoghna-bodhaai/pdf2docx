# --- OpenRouter -------------------------------------------------------------
# Required. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter's OpenAI-compatible endpoint. Change only if you are proxying it.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: OpenRouter attributes usage to these on its leaderboards.
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_TITLE=PDF to DOCX

# --- marker sidecar (the `marker` output mode) --------------------------------
# Needs sidecar/marker_service.py running; see sidecar/README-marker.md.
PDF2DOCX_MARKER_URL=http://127.0.0.1:8011
PDF2DOCX_MARKER_CONNECT_TIMEOUT=2
# A whole document rather than one page, so an order of magnitude longer.
PDF2DOCX_MARKER_REQUEST_TIMEOUT=900
# Passed through to marker's own config, which is the vocabulary its CLI flags
# use — anything the marker CLI accepts belongs here, and nothing is filtered:
#   {"mode":"fast","force_ocr":true,"use_llm":true,"output_format":"json"}
PDF2DOCX_MARKER_OPTIONS={}
# Extra renderers to run purely so their output can be read. Each one is a
# second conversion of the same PDF, so leave this empty unless comparing.
PDF2DOCX_MARKER_EXTRA_FORMATS=

# --- Model ------------------------------------------------------------------
# Any vision-capable model id from https://openrouter.ai/models
# (the web UI also lets you pick one per conversion).
PDF2DOCX_MODEL=anthropic/claude-sonnet-5

# Optional reasoning effort for reasoning-capable models: low | medium | high
# Leave blank to omit the parameter entirely.
PDF2DOCX_REASONING_EFFORT=

# Max output tokens per page
PDF2DOCX_MAX_TOKENS=16000

# --- Output ------------------------------------------------------------------
# structured = rebuild the PDF's own content as ordinary, editable Word structure
# replica    = reproduce each page exactly, with everything at its original
#              coordinates (blocks do not reflow when edited)
# flow       = have the model read the page and rewrite it as ordinary Word content
# marker     = convert the whole PDF locally with marker-pdf and keep what it
#              returns; its own Markdown is saved untouched beside the document
PDF2DOCX_LAYOUT=structured

# Columns in the flowing modes (flow, marker), and only the default — the web UI
# offers the same choice per conversion. The replica modes ignore this; they
# reproduce the page's geometry already.
# auto = read each source page and set the Word section to match, so a page set
#        in two columns comes back in two columns (the count is read from the
#        PDF itself, and from the ink on it when the page is a scan). The UI
#        calls this "multi-column"; "multi" is accepted here too.
# off  = one column throughout, whatever the source did. The UI calls this
#        "natural", one flowing column being what a transcription already is;
#        "natural" is accepted here too.
# 2    = force this many columns throughout (no equivalent in the UI)
PDF2DOCX_COLUMNS=auto

# Equations in replica mode:
# auto = read them back as native, editable Word equations
# off  = leave them as pixel-exact images (no model calls, no cost)
PDF2DOCX_MATH=auto

# Map PDF fonts onto fonts every machine has (Times New Roman / Arial /
# Courier New). Set to "off" to keep the document's own font names — only
# worth doing if the reader has those fonts installed.
PDF2DOCX_FONT_MAP=on

# --- Rendering & throughput -------------------------------------------------
# Page rasterisation DPI and hard cap on the long edge in pixels
PDF2DOCX_DPI=180
PDF2DOCX_MAX_EDGE=2000

# Resolution for rasterised diagrams and for equation crops
PDF2DOCX_DIAGRAM_DPI=300
PDF2DOCX_MATH_DPI=320

# Cap a figure cut out of a scanned page at the resolution the scan itself
# holds, instead of always cutting at PDF2DOCX_DIAGRAM_DPI. A 90 DPI scan has
# no 300 DPI detail to give: rendering it at 300 enlarges the paper grain and
# the JPEG blocks and nothing else. Vector artwork has no such ceiling and is
# always cut at the full resolution. "off" cuts everything at DIAGRAM_DPI.
PDF2DOCX_CROP_NATIVE=on

# Ask a second time where a scanned page's figures are, reading their boxes off
# a coordinate grid ruled over the page. The boxes that arrive alongside the
# transcription are its least reliable output — on the test page they averaged
# 0.13 IoU against boxes measured by hand, which crops the paragraph beside the
# diagram rather than the diagram; asking again averaged 0.55. Costs one extra
# request per page that has figures, around a cent. "off" trusts those boxes.
PDF2DOCX_LOCATE=on

# Which model does that locating. Reading a box off a ruled line is a different
# skill from transcribing, and a model can be good at one and poor at the other
# — so this pass can be pointed somewhere else. Blank means use PDF2DOCX_MODEL.
# The first thing to change if figures come out cropping the wrong region.
PDF2DOCX_FIGURE_MODEL=

# How many pages to transcribe in parallel
PDF2DOCX_CONCURRENCY=4

# Hard limit on pages per upload (0 = unlimited)
PDF2DOCX_MAX_PAGES=0

# --- Local history ----------------------------------------------------------
# Where past conversions and their finished documents are kept.
# Defaults to ~/.pdf2docx
PDF2DOCX_DATA_DIR=

# How many conversions to keep. The oldest are deleted, files and all.
# 0 = keep everything.
PDF2DOCX_HISTORY_LIMIT=100
