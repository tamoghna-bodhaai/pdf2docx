# --- OpenRouter -------------------------------------------------------------
# Required. Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter's OpenAI-compatible endpoint. Change only if you are proxying it.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: OpenRouter attributes usage to these on its leaderboards.
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_TITLE=PDF to DOCX

# --- Model ------------------------------------------------------------------
# Any vision-capable model id from https://openrouter.ai/models
# (the web UI also lets you pick one per conversion).
PDF2DOCX_MODEL=anthropic/claude-sonnet-5

# Optional reasoning effort for reasoning-capable models: low | medium | high
# Leave blank to omit the parameter entirely.
PDF2DOCX_REASONING_EFFORT=

# Max output tokens per page
PDF2DOCX_MAX_TOKENS=16000

# --- Output ------------------------------------------------------------------
# replica = reproduce each page exactly, with everything at its original
#           coordinates (blocks do not reflow when edited)
# flow    = have the model read the page and rewrite it as ordinary Word content
PDF2DOCX_LAYOUT=replica

# Equations in replica mode:
# auto = read them back as native, editable Word equations
# off  = leave them as pixel-exact images (no model calls, no cost)
PDF2DOCX_MATH=auto

# Map PDF fonts onto fonts every machine has (Times New Roman / Arial /
# Courier New). Set to "off" to keep the document's own font names — only
# worth doing if the reader has those fonts installed.
PDF2DOCX_FONT_MAP=on

# --- Rendering & throughput -------------------------------------------------
# Page rasterisation DPI and hard cap on the long edge in pixels
PDF2DOCX_DPI=180
PDF2DOCX_MAX_EDGE=2000

# Resolution for rasterised diagrams and for equation crops
PDF2DOCX_DIAGRAM_DPI=300
PDF2DOCX_MATH_DPI=320

# How many pages to transcribe in parallel
PDF2DOCX_CONCURRENCY=4

# Hard limit on pages per upload (0 = unlimited)
PDF2DOCX_MAX_PAGES=0

# --- Local history ----------------------------------------------------------
# Where past conversions and their finished documents are kept.
# Defaults to ~/.pdf2docx
PDF2DOCX_DATA_DIR=

# How many conversions to keep. The oldest are deleted, files and all.
# 0 = keep everything.
PDF2DOCX_HISTORY_LIMIT=100
