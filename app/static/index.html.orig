<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>PDF → DOCX</title>
<script>
  (() => {
    let theme = 'light';
    try {
      const saved = localStorage.getItem('pdf2docx-theme');
      theme = saved === 'light' || saved === 'dark'
        ? saved
        : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    } catch (_) {}
    document.documentElement.dataset.theme = theme;
  })();
</script>
<link rel="stylesheet" href="/static/vendor/katex/katex.min.css" />
<link rel="stylesheet" href="/static/app.css" />
</head>
<body>
<div class="shell">

  <!-- ------------------------------------------------------------- rail -- -->
  <aside class="rail">
    <div class="brand-row">
      <div class="brand-copy">
        <h1>PDF → editable Word</h1>
        <p class="sub">Convert a PDF, then read the page and the conversion side by side.</p>
      </div>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="false">
        <span id="theme-icon" aria-hidden="true">☀</span>
        <span id="theme-label">Light</span>
      </button>
    </div>

    <div class="warn hidden" id="keywarn">
      <strong>OPENROUTER_API_KEY is not set.</strong> Add it to <code>.env</code> and restart the server.
    </div>

    <div class="card" id="upload-card">
      <div id="drop">
        <strong>Drop a PDF here, or click to choose one</strong>
        <span id="hint">Loading configuration…</span>
      </div>
      <input id="picker" type="file" accept="application/pdf,.pdf" />

      <label class="field" for="layout">Output format</label>
      <div class="select-control">
        <select id="layout">
          <option value="structured">Editable document</option>
          <option value="replica">Visual replica</option>
          <option value="flow">Editable flow</option>
          <option value="marker">Marker (local)</option>
          <option value="mathpix">Mathpix (cloud)</option>
        </select>
      </div>
      <div class="hint" id="layout-hint"></div>

      <div id="columns-field" class="hidden">
        <label class="field" for="columns">Columns</label>
        <div class="select-control">
          <select id="columns">
            <option value="natural">Natural (one column)</option>
            <option value="multi">Match the source PDF</option>
          </select>
        </div>
        <div class="hint" id="columns-hint"></div>
      </div>

      <label class="field" for="model">Vision model <span id="model-note"></span></label>
      <div class="select-control">
        <select id="model"><option>Loading models…</option></select>
      </div>
    </div>

    <div class="card hidden" id="job-card">
      <div class="file" id="job-file"></div>
      <div class="meta" id="job-meta"></div>

      <div class="actions" id="start-actions">
        <button class="primary" id="start">Convert</button>
        <button id="discard">Discard</button>
      </div>

      <div class="hidden" id="run-area">
        <div class="bar"><i id="bar-fill"></i></div>
        <div class="status" id="job-status">Queued…</div>
        <div class="cost hidden" id="cost-box">Cost <b id="cost-value">—</b><span id="cost-note"></span></div>
      </div>

      <div class="actions hidden" id="actions">
        <a class="btn primary" id="dl-docx">.docx</a>
        <a class="btn" id="dl-md">.md</a>
        <a class="btn hidden" id="dl-marker">marker's own .md</a>
        <details class="exports-box hidden" id="mathpix-exports"></details>
        <button id="reset">Convert another</button>
      </div>
    </div>

    <details class="card history" id="history-panel">
      <summary>History <span class="meta" id="history-summary"></span></summary>
      <div class="tablewrap">
        <table id="history-table" class="hidden">
          <thead>
            <tr>
              <th>File</th><th>When</th><th class="num">Pages</th>
              <th>Mode</th><th class="num">Cost</th><th>Status</th><th></th>
            </tr>
          </thead>
          <tbody id="history-body"></tbody>
        </table>
      </div>
      <div class="empty" id="history-empty">No conversions yet.</div>
      <div class="actions" id="history-actions"></div>
    </details>

    <p class="sub">Runs locally · history kept on this machine</p>
  </aside>

  <!-- ---------------------------------------------------------- preview -- -->
  <section class="pane" id="preview-pane">
    <header>
      <h2>Document preview</h2>
      <div class="legend" id="legend"></div>
      <div class="spacer"></div>
      <div class="zoom">
        <button class="tiny" id="zoom-out" title="Zoom out">−</button>
        <button class="tiny" id="zoom-fit" title="Fit the pane">Fit</button>
        <button class="tiny" id="zoom-in" title="Zoom in">+</button>
      </div>
    </header>
    <div class="body" id="preview-body">
      <div class="placeholder" id="preview-empty">
        Convert a PDF, or pick one from the history, to see its pages and what the converter found on them.
      </div>
      <div class="stage-wrap hidden" id="stage-wrap">
        <div class="stage" id="stage">
          <img id="page-image" alt="" />
          <svg id="overlay" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"></svg>
        </div>
      </div>
    </div>
    <footer class="hidden" id="pager">
      <div class="pager">
        <button class="tiny" id="prev-page" title="Previous page">←</button>
        <input id="page-number" type="text" inputmode="numeric" value="1" />
        <span class="meta">/ <span id="page-total">1</span></span>
        <button class="tiny" id="next-page" title="Next page">→</button>
      </div>
      <span class="meta" id="page-note"></span>
    </footer>
  </section>

  <!-- ----------------------------------------------------------- output -- -->
  <section class="pane" id="output-pane">
    <header>
      <div class="tabs" id="tabs">
        <button data-tab="rendered" aria-selected="true">Markdown rendering</button>
        <button data-tab="text" aria-selected="false">Markdown text</button>
        <button data-tab="blocks" aria-selected="false">JSON blocks</button>
      </div>
      <div class="spacer"></div>
      <button class="tiny" id="scope">This page</button>
      <button class="tiny" id="copy">Copy</button>
    </header>
    <div class="body" id="output-body">
      <div class="placeholder" id="output-empty">The converted document appears here.</div>
      <div class="rendered hidden" id="tab-rendered"></div>
      <pre class="plain hidden" id="tab-text"></pre>
      <div class="blocks hidden" id="tab-blocks"></div>
    </div>
  </section>

</div>

<script src="/static/vendor/marked.min.js"></script>
<script src="/static/vendor/katex/katex.min.js"></script>
<script src="/static/vendor/katex/contrib/auto-render.min.js"></script>
<script src="/static/app.js"></script>
</body>
</html>
